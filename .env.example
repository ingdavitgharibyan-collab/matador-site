# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public https origin, no trailing slash. Compiled into the build (canonical, sitemap, QR, admin).
NEXT_PUBLIC_SERVER_URL=https://matador.am
# Other hosts that may open the admin (they are redirected to the one above anyway), comma-separated
SERVER_ALIASES=https://www.matador.am
# SQLite file and uploads (Docker sets /data/...)
DATABASE_URI=file:./matador.db
MEDIA_DIR=media
# First start only: the admin account (the server refuses to start in production without a user)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password-reset emails (optional; without SMTP use scripts/reset-password.ts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Kitchen bot (optional): create it with @BotFather, add it to the kitchen group, then
#   node --env-file=.env scripts/telegram-setup.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
KITCHEN_LOCALE=hy
# Optional: only these addresses may open /admin (comma-separated). Better still: Cloudflare Access in front of /admin.
ADMIN_ALLOWED_IPS=
